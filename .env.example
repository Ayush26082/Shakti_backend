# Copy this file to ".env" and fill in your real values. Never commit the real ".env".

PORT=3000

# SMTP details for sending emails (Gmail example: use an "App Password", not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where owner notifications go, and what "from" name/email customers see
OWNER_EMAIL=owner@example.com
FROM_EMAIL="Shakti Graphic Solution <your-email@gmail.com>"

# Secret key to view saved leads at /api/leads?key=THIS_VALUE — change it to something random
ADMIN_KEY=change-this-secret
